# Notice that every sample produces a slightly different estimate.
head(sample_means)
hist(sample_means, breaks = 25,
col = "lightblue",
main = "Sampling distribution of the sample mean",
xlab = "Observed sample mean",
las = 1)
return(sample_means)
}
