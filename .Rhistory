sample_quantile_distribution <- function(data, variable, nobs = 10, nrep = 1000) {
sample_variances <- map_dbl(.x = 1:nrep,
.f = \(i){
penguins_clean %>%
slice_sample(n = nobs) %>%
summarise(q90 = quantile(body_mass_g,
probs = 0.9)) %>%
pull(q90)})
# Display the first few estimates
# Notice that every sample produces a slightly different estimate.
head(sample_variances)
hist(sample_variances, breaks = 25,
col = "lightblue",
main = "Sampling distribution of the sample variance",
xlab = "Observed sample variance",
las = 1)
return(sample_variances)
}
